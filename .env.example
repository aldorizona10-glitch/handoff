# Copy to .env and fill in. .env is git-ignored and never leaves your machine.
# handoff only ever talks to the Anthropic API (plus the sites you drive).

# Your Anthropic API key — required for `handoff run` (not for `login`/`--dry-run`).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default model.
# HANDOFF_MODEL=claude-opus-5
